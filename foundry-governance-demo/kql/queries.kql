// Run in Application Insights > Logs (or the linked Log Analytics workspace).

// 1. GenAI model calls: latency and token usage per model
dependencies
| where timestamp > ago(1d)
| where isnotempty(customDimensions["gen_ai.operation.name"])
| extend model = tostring(customDimensions["gen_ai.response.model"]),
         inTok = toint(customDimensions["gen_ai.usage.input_tokens"]),
         outTok = toint(customDimensions["gen_ai.usage.output_tokens"])
| summarize calls = count(), p50_ms = percentile(duration, 50), p95_ms = percentile(duration, 95),
            inputTokens = sum(inTok), outputTokens = sum(outTok) by model, bin(timestamp, 1h)
| order by timestamp desc

// 2. Failed or blocked calls (content-filter blocks surface as HTTP 400)
dependencies
| where timestamp > ago(1d) and success == false
| project timestamp, name, resultCode, duration, operation_Id
| order by timestamp desc

// 3. Account request log by result code (needs the diagnostic setting -> Log Analytics)
AzureDiagnostics
| where TimeGenerated > ago(1d) and ResourceProvider == "MICROSOFT.COGNITIVESERVICES"
| summarize requests = count() by OperationName, ResultSignature, bin(TimeGenerated, 1h)
| order by TimeGenerated desc

// 4. Audit: who is calling the account
AzureDiagnostics
| where TimeGenerated > ago(1d) and Category == "Audit"
| summarize calls = count() by identity = tostring(identity_claim_upn_s), OperationName
| order by calls desc
